{
  "version": 2,
  "name": "anurag-portfolio",
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "server/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.js" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/mobile", "dest": "/mobile.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}

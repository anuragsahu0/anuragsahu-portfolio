# ============================================================
# ANTI GRAVITY PORTFOLIO — BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

PORT=5001
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Local (default): mongodb://127.0.0.1:27017/anti_gravity_portfolio
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio
MONGODB_URI=mongodb://127.0.0.1:27017/anti_gravity_portfolio

# ─── JWT Authentication ────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-change-this
JWT_EXPIRES_IN=7d

# ─── Admin Credentials (used by seed script) ──────────────
ADMIN_EMAIL=admin@anuragsahu.dev
ADMIN_PASSWORD=Meowww@123

# ─── Email / SMTP ──────────────────────────────────────────
RECIPIENT_EMAIL=shivasahu0612@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=shivasahu0612@gmail.com
SMTP_PASS=your-smtp-app-password-here

# ─── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

